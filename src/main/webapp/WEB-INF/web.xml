<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://xmlns.jcp.org/xml/ns/javaee
           http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
         
  	<display-name>KMJ Blog</display-name>
  
  	<!-- 1. properties 파일 읽기 -->
    <!-- <context:property-placeholder location="classpath:application.properties" /> -->
    
    <!-- 2. Root ApplicationContext 설정 -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>/WEB-INF/spring/root-context.xml</param-value>
    </context-param>
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class> <!-- root-context.xml을 읽어서 Root ApplicationContext 생성 -->
    </listener>
  	
  	<!-- 3. Spring MVC의 핵심 Servlet 등록 -->
	<servlet>
	    <!-- 3-0. servlet 명명 -->
	    <servlet-name>appServlet</servlet-name>
	    
	    <!-- 3-1. dispatcherServlet 등록 -->
	    <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
	    
	    <!-- 3-2. servlet 설정 파일 연결 -->
	    <init-param>
	        <param-name>contextConfigLocation</param-name>
	        <param-value>/WEB-INF/spring/servlet-context.xml</param-value> <!-- DispatcherServlet이 읽을 Spring MVC 설정 파일 위치 -->
	    </init-param>
	    
	    <!-- 3-3. 초기 servlet 생성 수: 1 -->
	    <load-on-startup>1</load-on-startup> <!-- Tomcat 시작 시 Servlet을 미리 생성 -->
	    
	    <!-- 3-4. multipart 설정 -->
	    <multipart-config>
		    <max-file-size>10485760</max-file-size> 			<!-- 파일 한 개당 최대 10MB -->
		    <max-request-size>12582912</max-request-size> 		<!-- multipart 요청 전체 최대 12MB -->
		    <file-size-threshold>1048576</file-size-threshold> 	<!-- 파일이 1MB를 초과하면 임시 디스크에 저장 -->
		</multipart-config>
	</servlet>
	
	<!-- 4. 모든 요청을 DispatcherServlet으로 보냄 -->
	<servlet-mapping>
		<servlet-name>appServlet</servlet-name>
	    <url-pattern>/</url-pattern>
	</servlet-mapping>
</web-app>
